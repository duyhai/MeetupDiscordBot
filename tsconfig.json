{
  "compilerOptions": {
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "inlineSourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*", "./tst/**/*", "./jest.config.cjs"],
  "exclude": ["node_modules", "__tests__"]
}
