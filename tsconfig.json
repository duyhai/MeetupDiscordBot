{
  "compilerOptions": {
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "inlineSourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "./src/**/*",
    "./tst/**/*",
    "./vitest.config.ts",
    "./vitest.integration.config.ts"
  ],
  "exclude": ["node_modules", "__tests__"]
}
