{
  "name": "meetupdiscordbot",
  "version": "1.0.0",
  "description": "A Discord bot for managing Meetup groups",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev_env.sh",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:docker": "yarn docker:up && DATABASE_URL=postgres://postgres:postgres@localhost:5432/meetup_bot REDISCLOUD_URL=redis://localhost:6379 yarn test:integration",
    "test:all": "yarn test && yarn test:integration",
    "docker:up": "bash scripts/docker-setup.sh",
    "docker:down": "bash scripts/docker-setup.sh down",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyhai/MeetupDiscordBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/duyhai/MeetupDiscordBot/issues"
  },
  "homepage": "https://github.com/duyhai/MeetupDiscordBot#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^4.17.7",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nock": "^14.0.16",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "dayjs": "^1.11.7",
    "decamelize": "^5.0.1",
    "discord.js": "^14.14.1",
    "discordx": "^11.7.6",
    "express": "^5.2.1",
    "graphql": "^16.6.0",
    "graphql-request": "^7.4.0",
    "memory-cache-node": "^1.4.0",
    "pg": "^8.23.0",
    "redis": "^4.6.13",
    "tslog": "^4.9.3",
    "tsx": "^4.23.1",
    "uuid": "^11.1.0"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "resolutions": {
    "@types/express": "^4.17.7",
    "superagent/form-data": "^4.0.4",
    "@types/superagent/form-data": "^4.0.4",
    "elliptic": "^6.6.1"
  }
}
