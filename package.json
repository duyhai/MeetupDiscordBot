{
  "name": "meetupdiscordbot",
  "version": "1.0.0",
  "description": "A Discord bot for managing Meetup groups",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev_env.sh",
    "start": "tsx src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "yarn lint -- --fix",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "yarn test && yarn test:integration",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyhai/MeetupDiscordBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/duyhai/MeetupDiscordBot/issues"
  },
  "homepage": "https://github.com/duyhai/MeetupDiscordBot#readme",
  "devDependencies": {
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^4.17.7",
    "@types/express-session": "^1.17.7",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "cookie-signature": "^1.2.2",
    "eslint": "^8.36.0",
    "eslint-config-airbnb-typescript-base": "^4.0.2",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-typescript-sort-keys": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nock": "^14.0.16",
    "prettier": "^2.8.7",
    "supertest": "^7.2.2",
    "typescript": "^5.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dayjs": "^1.11.7",
    "decamelize": "^5.0.1",
    "discord.js": "^14.14.1",
    "discordx": "^11.7.6",
    "express": "^5.2.1",
    "express-session": "^1.17.3",
    "grant": "^5.4.23",
    "graphql": "^16.6.0",
    "graphql-request": "^7.4.0",
    "memory-cache-node": "^1.4.0",
    "redis": "^4.6.13",
